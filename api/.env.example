# MongoDB Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority

# JWT Secret (Use a strong random string - minimum 32 characters)
JWT_SECRET=your_random_secure_jwt_secret_here_change_immediately

# Email Configuration (for password reset and notifications)
EMAIL_USER=your-email@domain.com
EMAIL_PASS=your_email_password
EMAIL_HOST=smtpout.secureserver.net
EMAIL_PORT=465

# Vercel Blob Storage (for image uploads)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxx_your_token_here

# Node Environment
NODE_ENV=production
